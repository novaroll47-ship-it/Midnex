{
  "name": "@cs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:fastify --external:@fastify/* --external:dotenv --external:ccxt --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cs/market": "*",
    "@cs/shared": "*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  }
}
