{
  "name": "@cs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/exchange-worker.ts src/scripts/migrate.ts src/scripts/history-maintenance.ts --bundle --platform=node --format=esm --target=node20 --external:fastify --external:@fastify/* --external:dotenv --external:ccxt --external:postgres --external:tsx --outdir=dist",
    "start": "node dist/index.js",
    "backfill": "tsx src/scripts/backfill.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "history:backup": "tsx src/scripts/history-maintenance.ts backup",
    "history:vacuum": "tsx src/scripts/history-maintenance.ts vacuum",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cs/market": "*",
    "@cs/shared": "*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  }
}
