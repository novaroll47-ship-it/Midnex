# --- Telegram ---
# Токен от @BotFather. Нужен и для валидации initData, и для отправки уведомлений.
TELEGRAM_BOT_TOKEN=

# Пускать в приложение без Telegram (открытие в обычном браузере на ПК).
# ВКЛЮЧАТЬ ТОЛЬКО ЛОКАЛЬНО. На проде должно быть 0.
DEV_FAKE_USER=1

# --- Сервер ---
API_PORT=8787
WEB_ORIGIN=http://localhost:5173

# --- База (M3+) ---
# Пусто -> локальный PGlite в ./.pglite. Иначе строка подключения к Postgres.
DATABASE_URL=

# --- Шифрование ключей бирж (M3+) ---
# 32 байта в hex. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_KEY=

# --- Рыночные данные ---
# live — котировки с восьми бирж (по умолчанию). mock — синтетика без сети,
# для работы над интерфейсом или когда биржи недоступны.
MARKET_MODE=live
# Прокси до бирж, если они недоступны напрямую (например, http://127.0.0.1:1080).
EXCHANGE_HTTPS_PROXY=

# Этап релиза: 1 — торговые разделы включены; пусто — только скринер, торговля помечена «Скоро».
TRADING_ENABLED=

# --- Подписка и оплата ---
# Telegram ID владельца: админ-команды в боте (/grant, /partners, /payouts …) и доступ без подписки.
ADMIN_TELEGRAM_ID=
# Курс звёзд Telegram к доллару для инвойсов (по умолчанию 50 ⭐ за $1).
STARS_PER_USD=50

# --- История спредов (SQLite рядом с процессом) ---
# Файл базы; пусто — .data/history.sqlite в корне проекта (в Docker — том /data).
HISTORY_DB_PATH=
# Сырые точки (раз в секунду) хранятся столько дней; минутные свечи — HISTORY_MINUTE_DAYS; 5m/1h — бессрочно.
HISTORY_RAW_DAYS=7
HISTORY_MINUTE_DAYS=30
# Сырые точки пишутся только по парам со спредом не ниже этого порога, %.
HISTORY_TICK_MIN_SPREAD=0.5
# VictoriaMetrics — посекундный спред для таймфрейма «1с» (поднимается deploy/run-local.ps1, retention 7 дней).
VICTORIA_URL=http://127.0.0.1:8428
# 0 — писать посекундно только лучшую пару по монете, без ≈14 тыс. серий по парам бирж.
VICTORIA_WRITE_PAIRS=1
# Сколько worker-потоков под ccxt (биржи раскладываются по кругу; каждый поток — ~80 МБ на сам ccxt).
MARKET_WORKERS=4

# Оплата через @CryptoBot (Crypto Pay API). Токен: /pay → Create App в @CryptoBot
# (для теста — @CryptoTestnetBot и CRYPTOPAY_TESTNET=1). Без токена способ скрыт.
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=0
# Случайная строка — секретный путь вебхука. Адрес вебхука в настройках приложения CryptoBot:
#   https://bilivlcjttmoelqeuwxz.supabase.co/functions/v1/cryptopay/<CRYPTOPAY_WEBHOOK_SECRET>
CRYPTOPAY_WEBHOOK_SECRET=
