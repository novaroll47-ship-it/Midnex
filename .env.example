# --- Telegram ---
# Токен от @BotFather. Нужен и для валидации initData, и для отправки уведомлений.
TELEGRAM_BOT_TOKEN=

# Пускать в приложение без Telegram (открытие в обычном браузере на ПК).
# ВКЛЮЧАТЬ ТОЛЬКО ЛОКАЛЬНО. На проде должно быть 0.
DEV_FAKE_USER=1

# --- Сервер ---
API_PORT=8787
WEB_ORIGIN=http://localhost:5173

# --- База (M3+) ---
# Пусто -> локальный PGlite в ./.pglite. Иначе строка подключения к Postgres.
DATABASE_URL=

# --- Шифрование ключей бирж (M3+) ---
# 32 байта в hex. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_KEY=

# --- Рыночные данные ---
# live — котировки с восьми бирж (по умолчанию). mock — синтетика без сети,
# для работы над интерфейсом или когда биржи недоступны.
MARKET_MODE=live
# Прокси до бирж, если они недоступны напрямую (например, http://127.0.0.1:1080).
EXCHANGE_HTTPS_PROXY=
