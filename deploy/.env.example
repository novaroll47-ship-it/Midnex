# Настройки сервера — deploy/.env (создаёт setup.sh, в git не попадает).
# Всё, что ниже, читает docker-compose и приложение внутри контейнера.

# Домен приложения: A-запись должна указывать на IP сервера. Без своего домена
# подойдёт 1-2-3-4.sslip.io (IP через дефисы) — setup.sh подставит его сам.
DOMAIN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Telegram ID владельца: админ-меню бота (/admin) и доступ без подписки.
ADMIN_TELEGRAM_ID=

# --- База (Supabase, пулер в режиме transaction, порт 6543) ---
DATABASE_URL=

# --- Шифрование ключей бирж: 32 байта hex. Потерять — потерять все ключи пользователей. ---
KEY_ENCRYPTION_KEY=

# --- Рынок ---
MARKET_MODE=live
# Worker-потоки под ccxt: 4 для 4 ГБ памяти, 2 — для 2 ГБ.
MARKET_WORKERS=4
MARKET_WORKER_HEAP_MB=384
# Прокси до бирж, если с сервера они недоступны напрямую.
EXCHANGE_HTTPS_PROXY=

# --- Подписка ---
# Курс звёзд к доллару для инвойсов.
STARS_PER_USD=50
# @CryptoBot: токен приложения и секретный путь вебхука
# (адрес вебхука: https://<DOMAIN>/api/cryptopay/webhook/<CRYPTOPAY_WEBHOOK_SECRET>).
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=0
CRYPTOPAY_WEBHOOK_SECRET=

# 1 — торговые разделы включены; пусто — только скринер («Скоро»).
TRADING_ENABLED=

# --- История ---
HISTORY_MINUTE_DAYS=30
VICTORIA_WRITE_PAIRS=1

# --- Логи ---
LOG_LEVEL=info
